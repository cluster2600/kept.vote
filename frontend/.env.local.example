# Base URL of the FastAPI backend. Used by Next.js server components.
#
# - Local (frontend run natively with `npm run dev`): point at the backend on
#   your host, e.g. http://localhost:8000
# - Docker compose (frontend run as a service): use the API service name,
#   e.g. http://api:8000
# - Vercel: set to your deployed backend URL.
API_BASE_URL=http://localhost:8000
