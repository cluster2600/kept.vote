# Base URL of the FastAPI backend.
#
# The app reads the API base from (in order): API_BASE_URL,
# NEXT_PUBLIC_API_BASE_URL, then a localhost:8000 fallback. All data fetching
# happens in server components, so either variable works.
#
# - Local (npm run dev):        API_BASE_URL=http://localhost:8000
# - Docker compose (service):   API_BASE_URL=http://api:8000
# - Vercel (production):        set NEXT_PUBLIC_API_BASE_URL to the Render API
#                               URL, e.g. https://kept-vote-api.onrender.com
API_BASE_URL=http://localhost:8000

# For Vercel, set this instead (Project → Settings → Environment Variables):
# NEXT_PUBLIC_API_BASE_URL=https://kept-vote-api.onrender.com
