# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Runtime environment: development | production
ENVIRONMENT=development

# PostgreSQL connection string. A plain postgresql:// URL is automatically
# upgraded to the async (asyncpg) driver by the app.
# For local docker-compose, the `db` host resolves to the Postgres service.
DATABASE_URL=postgresql://postgres:postgres@db:5432/promises

# Connection-pool tuning (optional — sensible defaults are used if unset).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Anthropic / Claude API key (required for /api/verify).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional Claude overrides.
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_MAX_TOKENS=4096

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=26214400
